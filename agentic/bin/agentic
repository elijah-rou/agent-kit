#!/usr/bin/env bun
/**
 * agentic: entry point for the agentic stack's tools. Each subcommand passes its arguments to the
 * tool's own CLI (each has --help):
 *   rulesets         plan or apply the GitHub ruleset that backstops agents (tools/rulesets)
 *   upstream-drift   report upstream changes since each adapted skill's recorded commit (tools/upstream-drift)
 *   verify           record or check a fresh verifier's verdict for a pull request (tools/verify)
 *   jev              advisory Jev calls: PR risk for the ship mode, task-class hints (tools/jev)
 *   orch             program store and verdict ledger, vendored from pstack (vendor/orch)
 *   watch-pr         pull request and stack watcher, vendored from pstack (vendor/watch-pr)
 */
import { join } from "node:path";

const TOOLS: Record<string, string> = {
	rulesets: "tools/rulesets/cli.ts",
	"upstream-drift": "tools/upstream-drift/cli.ts",
	verify: "tools/verify/cli.ts",
	jev: "tools/jev/cli.ts",
	orch: "vendor/orch/orch.ts",
	"watch-pr": "vendor/watch-pr/watch-pr",
};

const [tool, ...rest] = process.argv.slice(2);
const script = tool === undefined ? undefined : TOOLS[tool];
if (script === undefined) {
	console.error(`usage: agentic ${Object.keys(TOOLS).join(" | ")} [args]`);
	process.exit(tool === "--help" || tool === "-h" ? 0 : 2);
}
const child = Bun.spawnSync([process.execPath, join(import.meta.dir, "..", script), ...rest], { stdio: ["inherit", "inherit", "inherit"] });
process.exit(child.exitCode ?? 1);
