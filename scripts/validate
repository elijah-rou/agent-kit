#!/usr/bin/env bash
# Static checks plus the Pi extension and Claude mod tests. Needs Node, Bun, ripgrep, and Python.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

git diff --check
python3 scripts/check-public-safety --index
python3 scripts/check-public-safety --worktree
bun scripts/check-skills.ts

# Pi loads the extensions with its Node-compatible runtime; the tests use Node's runner.
pi_tests=()
while IFS= read -r -d '' file; do pi_tests+=("$file"); done < <(find pi/tests -maxdepth 1 -type f -name '*.test.mjs' -print0 | sort -z)
node --test "${pi_tests[@]}"

# Claude mods are Bun TypeScript; the runtime test runs only where a `claude` CLI exists.
bun test claude/tests
