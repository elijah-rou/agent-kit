#!/usr/bin/env bash
# Static checks plus the Pi extension and Claude mod tests. Needs Bun, ripgrep, zsh, and Python.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

git diff --check
python3 scripts/check-public-safety --index
python3 scripts/check-public-safety --worktree
bun scripts/check-skills.ts

# The kit runs Pi extensions on Bun, so they are tested there too.
bun test pi/tests

# The agentic tools (rulesets, upstream-drift).
bun test agentic

# Scripts that ship inside skills (repo-baseline).
bun test skills

# Claude mods are Bun TypeScript; the runtime test runs only where a `claude` CLI exists.
bun test claude/tests
