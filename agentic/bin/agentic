#!/usr/bin/env bun
/**
 * Entry point for the agentic CLI (src/cli.ts). It imports nothing statically, so a missing or
 * broken dependency surfaces here: for claude-hook that becomes an explicit deny, because Claude
 * Code lets a tool run when its hook exits with an error.
 */
try {
	await import("../src/cli.ts");
} catch (error) {
	if (process.argv[2] !== "claude-hook") throw error;
	const reason = `[agentic] policy layer failed to load, failing closed: ${(error as Error).message}`;
	console.log(JSON.stringify({ hookSpecificOutput: { hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: reason } }));
	process.exit(0);
}
