#!/usr/bin/env bash
# Static checks plus the agentic policy layer, Pi extension, and Claude mod tests. Needs Bun, ripgrep, zsh, and Python.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

git diff --check
python3 scripts/check-public-safety --index
python3 scripts/check-public-safety --worktree
bun scripts/check-skills.ts

# Every rule names a real enforcer and past mistake, and no skill restates a rule an enforcer owns.
agentic/bin/agentic rule-table check agentic/rules.toml
find skills claude/skills -name '*.md' -print0 | sort -z | xargs -0 agentic/bin/agentic rule-table duplicates --rules agentic/rules.toml

# Bootstrap runs Pi on Bun, so the extensions are tested there too.
bun test pi/tests

# The agentic policy layer: library, Cedar policies, CLI, and tools.
bun test agentic

# Claude mods are Bun TypeScript; the runtime test runs only where a `claude` CLI exists.
bun test claude/tests
