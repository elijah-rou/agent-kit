#!/usr/bin/env python3
"""Run the verification skill's public-safety scanner on this repository; arguments pass through (--index by default)."""

import os
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
SCANNER = ROOT / "skills/verification/scripts/scan-public-safety"
os.execv(sys.executable, [sys.executable, str(SCANNER), "--repo", str(ROOT), *sys.argv[1:]])
