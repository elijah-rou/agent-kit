#!/usr/bin/env bun
// Control CLI for the verify-agent-kit skill. It drives an agent-kit checkout's own entry points (the
// agentic CLI, the prompt-routing hook, the git guard hook, the skill exports, the Claude Code Mod and status line) the way
// the runtimes call them, with every writable store redirected into a per-run directory. The kit that
// runs need not be the checkout it drives: a verifier runs trunk's kit with --checkout <head>, so a pull
// request never supplies its own verifier.
import { spawnSync } from "node:child_process";
import { createHash } from "node:crypto";
import { existsSync, lstatSync, mkdirSync, readdirSync, readFileSync, readlinkSync, realpathSync, rmSync, writeFileSync } from "node:fs";
import { homedir, tmpdir, userInfo } from "node:os";
import { basename, join, resolve } from "node:path";

const KIT_DIR = resolve(import.meta.dir, "..");
const KIT_CHECKOUT = realpathSync(resolve(KIT_DIR, "../../.."));
const CLI = ".agents/skills/verify-agent-kit/scripts/verify-kit";
const RUNS_ROOT = join(tmpdir(), "verify-agent-kit");
const EVIDENCE_ROOT = join(process.env.XDG_STATE_HOME || join(homedir(), ".local", "state"), "verify-agent-kit", "evidence");
const RUN_ID = /^ak-\d{8}-\d{6}-\d+$/;
// Versioned so a kit from before the kit-binding check refuses runs this kit launched.
const MARKER = "verify-kit run v2";
const STEP_TIMEOUT_MS = 180_000;
const FEATURES = ["task-route", "verdict-gate", "pr-state", "skill-catalog", "claude-surface", "git-guard"] as const;
type Feature = (typeof FEATURES)[number];
type Outcome = { state: "PASS" | "FAIL" | "SKIP"; detail?: string };
type RunInfo = { marker: string; runId: string; checkout: string; revision: string; tree: string; kit: string; kitRevision: string; kitTree: string; dirty: boolean; startedAt: string };
const DIRTY = "WARNING dirty run: its evidence cannot back a verdict";
const ALLOWED_JEV_FALLBACKS = ["low-confidence", "conflict", "model-drift"];
type Options = { slug?: string; pr?: number; mergedPr?: number };

const HELP: Record<string, string> = {
	main: `Usage: ${CLI} <command> [args]

Drives an agent-kit checkout's entry points with every store redirected into a per-run directory.

Commands:
  launch [--checkout PATH] [--install] [--allow-dirty]
                                         start a run; prints RUN_ID and EVIDENCE_DIR
  doctor RUN_ID                          read-only: is this run worth driving?
  drive RUN_ID <feature> [options]       drive one mapped feature; ends with PASS, FAIL, or SKIP
  cleanup RUN_ID                         remove this run's directory; evidence stays
  all [--checkout PATH] [--install] [--allow-dirty] [options]
                                         launch, doctor, every feature, cleanup, then a count

Features: ${FEATURES.join(", ")}

Examples:
  ${CLI} launch
  ${CLI} launch --checkout ../agent-verify-head --install
  ${CLI} doctor ak-20261012-213000-4242
  ${CLI} drive ak-20261012-213000-4242 task-route
  ${CLI} all --checkout ../agent-verify-head --pr 31

Run "${CLI} <command> --help" for each command's options.
`,
	launch: `Usage: ${CLI} launch [--checkout PATH] [--install] [--allow-dirty]

Creates the run directory $TMPDIR/verify-agent-kit/<RUN_ID> with its own XDG_STATE_HOME, orch store,
and two scratch git repositories, records the driven checkout's revision and a digest of its tracked
and untracked files, and prints RUN_ID, EVIDENCE_DIR, and the readiness line
"READY verify-agent-kit <RUN_ID>".

  --checkout PATH   the agent-kit checkout to drive (default: the checkout holding this kit). To verify
                    a pull request, run trunk's kit with --checkout pointing at the head's worktree.
  --install         first run "bun install --frozen-lockfile" in that checkout (it writes
                    node_modules/, which this run did not create, so it needs the flag)
  --allow-dirty     drive a checkout or kit with uncommitted changes; every result is marked as
                    unable to back a verdict. Without it, launch refuses a dirty tree: verify a
                    fresh worktree at the commit instead (git worktree add --detach PATH SHA).

Examples:
  ${CLI} launch
  ${CLI} launch --checkout ../agent-verify-head --install
`,
	doctor: `Usage: ${CLI} doctor RUN_ID

Read-only. Checks the run directory, that the driven checkout still has the launched revision and
tree, that its agentic CLI starts and its node_modules matches bun.lock, and reports which optional
prerequisites (gh login, TypeSafe key, claude CLI) are present. Ends with DOCTOR PASS or DOCTOR FAIL.

Example:
  ${CLI} doctor ak-20261012-213000-4242
`,
	drive: `Usage: ${CLI} drive RUN_ID <feature> [--repo owner/name] [--pr N] [--merged-pr N]

Drives one feature from features/ and ends with "PASS <feature>", "FAIL <feature>: <check>", or
"SKIP <feature>: <missing prerequisites>". A SKIP still ran every step whose prerequisites held.
Evidence goes to EVIDENCE_DIR/<feature>/. It refuses to drive a checkout that moved since launch.

  --repo owner/name   the GitHub repository (default: the driven checkout's origin)
  --pr N              the open pull request under test: the driven checkout must be at its head. It
                      is read, and gets a non-passing smoke verdict in this run's own ledger
                      (default: the newest open pull request, as a smoke check only)
  --merged-pr N       a merged pull request to read and to screen (default: the newest merged one)

Features: ${FEATURES.join(", ")}

Examples:
  ${CLI} drive ak-20261012-213000-4242 task-route
  ${CLI} drive ak-20261012-213000-4242 verdict-gate --pr 31
  ${CLI} drive ak-20261012-213000-4242 pr-state --merged-pr 22
  ${CLI} drive ak-20261012-213000-4242 skill-catalog
  ${CLI} drive ak-20261012-213000-4242 claude-surface
  ${CLI} drive ak-20261012-213000-4242 git-guard
`,
	cleanup: `Usage: ${CLI} cleanup RUN_ID

Removes $TMPDIR/verify-agent-kit/<RUN_ID>, the only thing a run creates outside evidence, after checking
its marker names this RUN_ID. Never touches evidence, the checkout, or another run.

Example:
  ${CLI} cleanup ak-20261012-213000-4242
`,
	all: `Usage: ${CLI} all [--checkout PATH] [--install] [--allow-dirty] [--repo owner/name] [--pr N] [--merged-pr N]

Launches a run, runs doctor and every feature, cleans up even after a failure, and ends with
"ALL <RUN_ID>: <n> pass, <n> fail, <n> skip". Exits 0 only when doctor passed and no feature failed.

Examples:
  ${CLI} all
  ${CLI} all --checkout ../agent-verify-head --pr 31
`,
};

class Usage extends Error {}

function option(args: string[], name: string): string | undefined {
	const index = args.indexOf(name);
	if (index === -1) return undefined;
	const value = args[index + 1];
	if (value === undefined || value.startsWith("--")) throw new Usage(`${name} needs a value`);
	return value;
}

function positiveInt(value: string | undefined, name: string): number | undefined {
	if (value === undefined) return undefined;
	if (!/^[1-9]\d*$/.test(value)) throw new Usage(`${name} must be a pull request number, got "${value}"`);
	return Number(value);
}

function sh(argv: string[], options: { cwd: string; env?: Record<string, string>; input?: string }) {
	const result = spawnSync(argv[0]!, argv.slice(1), {
		cwd: options.cwd,
		env: { ...process.env, ...options.env },
		input: options.input ?? "",
		encoding: "utf8",
		timeout: STEP_TIMEOUT_MS,
		maxBuffer: 32 * 1024 * 1024,
	});
	return { status: result.status ?? (result.signal ? 128 : 1), stdout: result.stdout ?? "", stderr: (result.stderr ?? "") + (result.error ? String(result.error) : "") };
}

function git(args: string[], cwd: string): string {
	const result = sh(["git", ...args], { cwd });
	if (result.status !== 0) throw new Error(`git ${args.join(" ")} in ${cwd} failed: ${result.stderr.trim()}`);
	return result.stdout.trim();
}

/** Tracked changes against HEAD plus every untracked, not ignored file's path and bytes. */
function treeDigest(checkout: string): string {
	const hash = createHash("sha256");
	hash.update(sh(["git", "diff", "HEAD", "--binary"], { cwd: checkout }).stdout);
	for (const path of git(["ls-files", "--others", "--exclude-standard", "-z"], checkout).split("\0").filter(Boolean).sort()) {
		const full = join(checkout, path);
		const stat = lstatSync(full);
		hash.update(`\0${path}\0`);
		// A nested repository is listed as a directory and a link is hashed as its target, never followed.
		if (stat.isSymbolicLink()) hash.update(`link:${readlinkSync(full)}`);
		else if (stat.isDirectory()) hash.update("directory");
		else hash.update(readFileSync(full));
	}
	return hash.digest("hex").slice(0, 16);
}

/** Uncommitted changes or untracked, not ignored files, if any. */
function dirtyState(path: string): string | undefined {
	const status = git(["status", "--porcelain=v1", "-uall"], path);
	return status ? status.split("\n").slice(0, 5).join("; ") : undefined;
}

function runDir(runId: string): string {
	return join(RUNS_ROOT, runId);
}

function evidenceDir(runId: string): string {
	return join(EVIDENCE_ROOT, runId);
}

function loadRun(runId: string | undefined): RunInfo {
	if (runId === undefined || !RUN_ID.test(runId)) throw new Usage(`not a verify-kit run ID: "${runId ?? ""}"; launch prints one like ak-20261012-213000-4242`);
	const file = join(runDir(runId), "run.json");
	if (!existsSync(file)) throw new Error(`no run ${runId} under ${RUNS_ROOT}; run "${CLI} launch" and use the RUN_ID it prints`);
	const info = JSON.parse(readFileSync(file, "utf8")) as RunInfo;
	if (info.marker !== MARKER || info.runId !== runId) throw new Error(`${file} was not written by verify-kit for ${runId}; refusing to drive it`);
	if (info.kit !== KIT_CHECKOUT) throw new Error(`run ${runId} was launched by the kit in ${info.kit}; drive it with that kit, or launch a run with this one`);
	return info;
}

/** Fails unless the driven checkout and the kit still have the revisions and trees recorded at launch. */
function bound(run: RunInfo): string | undefined {
	for (const [what, path, revisionAt, treeAt] of [["checkout", run.checkout, run.revision, run.tree], ["kit", run.kit, run.kitRevision, run.kitTree]] as const) {
		const revision = git(["rev-parse", "HEAD"], path);
		if (revision !== revisionAt) return `${what} ${path} moved from ${revisionAt.slice(0, 12)} to ${revision.slice(0, 12)} since launch; launch a new run`;
		if (treeDigest(path) !== treeAt) return `${what} ${path} changed since launch (tree digest ${treeAt}); launch a new run`;
	}
	return undefined;
}

/** Runs each step, writes its command, exit code, stdout, and stderr to the evidence file, and collects failures and skips. */
class Recorder {
	private index = 0;
	readonly failures: string[] = [];
	readonly skips: string[] = [];
	constructor(readonly dir: string, readonly checkout: string) {
		mkdirSync(dir, { recursive: true });
	}
	step(name: string, argv: string[], options: { cwd?: string; env?: Record<string, string>; input?: string } = {}) {
		const cwd = options.cwd ?? this.checkout;
		const result = sh(argv, { ...options, cwd });
		const file = join(this.dir, `${String(++this.index).padStart(2, "0")}-${name}.txt`);
		const env = Object.entries(options.env ?? {}).map(([key, value]) => `${key}=${value}`).join(" ");
		writeFileSync(file, [
			`$ ${argv.map((part) => (/^[\w./:=@+-]+$/.test(part) ? part : JSON.stringify(part))).join(" ")}`,
			`cwd: ${cwd}`,
			env ? `env: ${env}` : "env: (inherited)",
			options.input ? `stdin: ${options.input}` : "stdin: (empty)",
			`exit: ${result.status}`,
			"--- stdout",
			result.stdout,
			"--- stderr",
			result.stderr,
		].join("\n"));
		return result;
	}
	note(name: string, text: string): void {
		writeFileSync(join(this.dir, name), text);
	}
	check(condition: boolean, what: string): boolean {
		if (!condition) this.failures.push(what);
		return condition;
	}
	skip(prerequisite: string): void {
		this.skips.push(prerequisite);
	}
	outcome(): Outcome {
		if (this.failures.length) return { state: "FAIL", detail: this.failures[0] };
		if (this.skips.length) return { state: "SKIP", detail: this.skips.join("; ") };
		return { state: "PASS" };
	}
}

function ghReady(): boolean {
	return Bun.which("gh") !== null && sh(["gh", "auth", "status"], { cwd: KIT_CHECKOUT }).status === 0;
}

/** Whether a TypeSafe key is configured, without reading it. */
function typesafeKeyPresent(): boolean {
	if (process.env.TYPESAFE_API_KEY?.trim()) return true;
	if (process.platform !== "darwin") return false;
	return sh(["security", "find-generic-password", "-a", userInfo().username, "-s", "typesafe-jev"], { cwd: KIT_CHECKOUT }).status === 0;
}

function originSlug(checkout: string): string | undefined {
	const remote = sh(["git", "remote", "get-url", "origin"], { cwd: checkout }).stdout.trim();
	return /^(?:https:\/\/|ssh:\/\/git@|git@)github\.com[/:]([\w.-]+\/[\w.-]+?)(?:\.git)?\/?$/.exec(remote)?.[1];
}

/**
 * A gh fetch a drive depends on. A non-zero exit or empty output throws, naming the command, so the
 * drive FAILs instead of reading a failed fetch as an empty answer (the README: a gh failure is a FAIL).
 */
function ghText(args: string[]): string {
	const command = `gh ${args.join(" ")}`;
	const result = sh(["gh", ...args], { cwd: KIT_CHECKOUT });
	if (result.status !== 0) throw new Error(`${command} failed (exit ${result.status}): ${result.stderr.trim()}`);
	if (result.stdout.trim() === "") throw new Error(`${command} printed nothing`);
	return result.stdout;
}

/** The newest pull request in a state, undefined when there is none; a gh failure is an error, not a skip. */
function newestPr(slug: string, state: "open" | "merged"): number | undefined {
	return (JSON.parse(ghText(["pr", "list", "-R", slug, "--state", state, "--limit", "1", "--json", "number"])) as { number: number }[])[0]?.number;
}

function ghJson(path: string): unknown {
	return JSON.parse(ghText(["api", path]));
}

function parseJson(text: string): unknown {
	try {
		return JSON.parse(text);
	} catch {
		return undefined;
	}
}

/** JSON with object keys sorted, so key order never decides an equality check. */
function canonical(value: unknown): string {
	const sort = (item: unknown): unknown => Array.isArray(item) ? item.map(sort) : item !== null && typeof item === "object" ? Object.fromEntries(Object.keys(item).sort().map((key) => [key, sort((item as Record<string, unknown>)[key])])) : item;
	return JSON.stringify(sort(value));
}

function sameList(actual: readonly string[] | undefined, expected: readonly string[]): boolean {
	return actual !== undefined && actual.length === expected.length && actual.every((value, index) => value === expected[index]);
}

// ---------------------------------------------------------------- launch, doctor, cleanup

function launch(args: string[]): string {
	const checkoutArg = option(args, "--checkout");
	const requested = checkoutArg === undefined ? KIT_CHECKOUT : resolve(checkoutArg);
	if (!existsSync(join(requested, "agentic/bin/agentic"))) throw new Usage(`${requested} is not an agent-kit checkout (no agentic/bin/agentic); pass --checkout with one`);
	// Compare real paths: on macOS /tmp is a link to /private/tmp, and git reports the resolved top.
	const checkout = realpathSync(requested);
	if (realpathSync(git(["rev-parse", "--show-toplevel"], checkout)) !== checkout) throw new Usage(`${checkout} is not the top of its git checkout; pass its root to --checkout`);
	const allowDirty = args.includes("--allow-dirty");
	const dirty: (readonly [string, string | undefined])[] = [...new Set([checkout, KIT_CHECKOUT])].map((path) => [path, dirtyState(path)] as const).filter(([, state]) => state !== undefined);
	if (dirty.length && !allowDirty) {
		throw new Usage(`${dirty.map(([path, state]) => `${path} has uncommitted changes (${state})`).join("; ")}. Commit them, or verify a fresh worktree at the commit (git worktree add --detach PATH SHA), or pass --allow-dirty for a run whose evidence cannot back a verdict`);
	}
	if (args.includes("--install")) {
		const install = sh(["bun", "install", "--frozen-lockfile"], { cwd: checkout });
		if (install.status !== 0) throw new Error(`bun install --frozen-lockfile failed in ${checkout}: ${install.stderr.trim()}`);
		const installed = dirtyState(checkout);
		if (installed !== undefined && !allowDirty) throw new Usage(`bun install left uncommitted changes in ${checkout} (${installed}); commit or ignore them, or pass --allow-dirty for a run whose evidence cannot back a verdict`);
		if (installed !== undefined && !dirty.some(([path]) => path === checkout)) dirty.push([checkout, installed]);
	}
	const now = new Date();
	const runId = `ak-${now.toISOString().replace(/[-:]/g, "").replace("T", "-").slice(0, 15)}-${process.pid}`;
	const dir = runDir(runId);
	if (existsSync(dir)) throw new Error(`${dir} already exists; launch again`);
	mkdirSync(join(dir, "state"), { recursive: true });
	mkdirSync(join(dir, "orch"), { recursive: true });
	// Two scratch repositories for the routing hook: a plain checkout and one that opts out of Jev.
	for (const name of ["fixture", "fixture-optout"]) {
		mkdirSync(join(dir, name));
		git(["init", "-q", "-b", "main"], join(dir, name));
	}
	mkdirSync(join(dir, "fixture-optout", ".agents"));
	writeFileSync(join(dir, "fixture-optout", ".agents", "jev-opt-out"), "verify-agent-kit fixture\n");
	const info: RunInfo = {
		marker: MARKER,
		runId,
		checkout,
		revision: git(["rev-parse", "HEAD"], checkout),
		tree: treeDigest(checkout),
		kit: KIT_CHECKOUT,
		kitRevision: git(["rev-parse", "HEAD"], KIT_CHECKOUT),
		kitTree: treeDigest(KIT_CHECKOUT),
		dirty: dirty.length > 0,
		startedAt: now.toISOString(),
	};
	writeFileSync(join(dir, "run.json"), JSON.stringify(info, null, 2) + "\n");
	mkdirSync(evidenceDir(runId), { recursive: true });
	writeFileSync(join(evidenceDir(runId), "launch.txt"), JSON.stringify({ ...info, runDir: dir }, null, 2) + "\n");
	console.log(`RUN_ID=${runId}`);
	console.log(`EVIDENCE_DIR=${evidenceDir(runId)}`);
	if (info.dirty) console.log(DIRTY);
	console.log(`READY verify-agent-kit ${runId}`);
	return runId;
}

function doctor(runId: string | undefined): boolean {
	const run = loadRun(runId);
	const lines: string[] = [];
	let ok = true;
	const need = (condition: boolean, pass: string, fail: string) => {
		lines.push(condition ? `ok   ${pass}` : `FAIL ${fail}`);
		ok &&= condition;
	};
	const dir = runDir(run.runId);
	const stores = ["state", "orch", "fixture", "fixture-optout/.agents/jev-opt-out"].every((path) => existsSync(join(dir, path)));
	need(stores, `run directory ${dir} holds state/, orch/, and both fixtures`, `run directory ${dir} is missing a store or fixture; launch a new run`);
	const moved = bound(run);
	need(moved === undefined, `checkout ${run.checkout} is at the launched revision ${run.revision.slice(0, 12)} with the launched tree`, moved ?? "");
	const agentic = sh(["bun", join(run.checkout, "agentic/bin/agentic"), "--help"], { cwd: run.checkout });
	const tools = ["rulesets", "upstream-drift", "verify", "jev", "pr-feedback", "orch", "watch-pr"];
	const listed = agentic.status === 0 && tools.every((tool) => agentic.stderr.includes(tool));
	need(listed, `the checkout's agentic CLI starts and lists ${tools.join(", ")}`, `the checkout's agentic CLI did not start or list ${tools.join(", ")}; read EVIDENCE_DIR/doctor.txt`);
	const locked = /"commander@([\d.]+)"/.exec(readFileSync(join(run.checkout, "bun.lock"), "utf8"))?.[1];
	const installedFile = join(run.checkout, "node_modules/commander/package.json");
	const installed = existsSync(installedFile) ? (JSON.parse(readFileSync(installedFile, "utf8")) as { version: string }).version : undefined;
	need(locked !== undefined && installed === locked, `node_modules has commander ${locked} from bun.lock`, `node_modules has commander ${installed ?? "none"}, bun.lock wants ${locked ?? "?"}; run "${CLI} launch --checkout ${run.checkout} --install"`);
	lines.push(`info gh login: ${ghReady() ? "ready" : "absent (verdict-gate and pr-state skip their GitHub steps)"}`);
	lines.push(`info TypeSafe key: ${typesafeKeyPresent() ? "present" : "absent (task-route and verdict-gate skip their Jev steps)"}`);
	const claude = Bun.which("claude");
	lines.push(`info claude CLI: ${claude ? sh([claude, "--version"], { cwd: KIT_CHECKOUT }).stdout.trim() : "absent (claude-surface skips the Mod steps)"}`);
	lines.push(`info kit ${run.kit} at ${run.kitRevision.slice(0, 12)}${run.kit === run.checkout ? " drives itself" : ` drives ${run.checkout}`}; bun ${Bun.version}; the agentic on PATH is never used`);
	if (run.dirty) lines.push(DIRTY);
	lines.push(ok ? `DOCTOR PASS ${run.runId} revision ${run.revision.slice(0, 12)}` : `DOCTOR FAIL ${run.runId}`);
	const text = lines.join("\n") + "\n";
	mkdirSync(evidenceDir(run.runId), { recursive: true });
	writeFileSync(join(evidenceDir(run.runId), "doctor.txt"), text);
	process.stdout.write(text);
	return ok;
}

function cleanup(runId: string | undefined): void {
	const run = loadRun(runId);
	const dir = runDir(run.runId);
	rmSync(dir, { recursive: true, force: true });
	const gone = !existsSync(dir);
	const text = `${gone ? "removed" : "FAILED to remove"} ${dir}\nkept ${evidenceDir(run.runId)}\nstarted nothing else: drives are synchronous and open no ports, sessions, or containers\n`;
	mkdirSync(evidenceDir(run.runId), { recursive: true });
	writeFileSync(join(evidenceDir(run.runId), "cleanup.txt"), text);
	process.stdout.write(text);
	if (!gone) throw new Error(`could not remove ${dir}`);
}

// ---------------------------------------------------------------- features

function hookEvent(sessionId: string, cwd: string, prompt: string): string {
	return JSON.stringify({ session_id: sessionId, cwd, prompt, hook_event_name: "UserPromptSubmit", transcript_path: "/dev/null" });
}

function routeRecords(state: string, file: string): Record<string, unknown>[] {
	const root = join(state, "agentic", "task-route");
	if (!existsSync(root)) return [];
	for (const machine of readdirSync(root)) {
		const path = join(root, machine, file);
		if (existsSync(path)) return readFileSync(path, "utf8").split("\n").filter(Boolean).map((line) => JSON.parse(line) as Record<string, unknown>);
	}
	return [];
}

/** A record must not carry the prompt: no prompt or text field, and for a prompt long enough to be distinctive, no value containing it. */
function holdsPrompt(record: Record<string, unknown>, prompt: string): boolean {
	if ("prompt" in record || "text" in record) return true;
	return prompt.trim().length >= 16 && JSON.stringify(record).includes(prompt.trim().slice(0, 24));
}

/**
 * The route report over the records the withheld steps just wrote, checked against the drive's own
 * count of them, plus one correction record in the fixture's git directory joined by session.
 */
function driveRouteReport(run: RunInfo, rec: Recorder, state: string, fixture: string, written: number): void {
	const agentic = join(run.checkout, "agentic/bin/agentic");
	const corrections = join(fixture, ".git", "agentic", "corrections");
	mkdirSync(corrections, { recursive: true });
	const correction = { kind: "repo", class: "verify-fixture", correction: "fixture words", text: "fixture rule", evidence: { session: `${run.runId}-not-a-task`, date: "2026-10-14" } };
	writeFileSync(join(corrections, `${run.runId}-not-a-task.json`), JSON.stringify([correction]));
	const entries = () => readdirSync(state, { recursive: true }).length;
	const before = entries();
	const json = rec.step("route-report-json", ["bun", agentic, "jev", "route-report", "--json"], { cwd: fixture, env: { XDG_STATE_HOME: state } });
	type Row = { runtime: string; prompts: number; classified: number; noted: number; fallbacks: Record<string, number> };
	const report = parseJson(json.stdout) as { window?: { days?: number }; ledger?: { inWindow?: number; malformed?: number }; policy?: { shown?: string; records?: number; others?: Record<string, number> }; runtimes?: Row[]; notes?: { decided: number }[]; corrections?: { kind?: string; repo?: string; records?: number; rows?: { group: string; corrections: number }[]; caveat?: string } } | undefined;
	rec.check(json.status === 0 && report !== undefined, `report: agentic jev route-report --json exits 0 with JSON (exit ${json.status})`);
	rec.check(report?.window?.days === 7, "report: the default window is 7 days");
	rec.check(report?.ledger?.inWindow === written && report.ledger.malformed === 0, `report: it reads the ${written} records the drive wrote (got ${report?.ledger?.inWindow})`);
	rec.check(report?.policy?.records === written && Object.keys(report.policy.others ?? {}).length === 0, `report: the shown policy (${report?.policy?.shown}) holds every record the drive wrote, and no other policy is mixed in (got ${JSON.stringify(report?.policy)})`);
	const runtime = (name: string) => report?.runtimes?.find((row) => row.runtime === name);
	const claude = runtime("claude");
	const expected = { off: 1, "not-a-task": 1, system: 1, "unsafe-input": 1, "opted-out": 1 };
	rec.check(claude?.prompts === written && JSON.stringify(Object.entries(claude.fallbacks).sort()) === JSON.stringify(Object.entries(expected).sort()), `report: claude's prompts and fallbacks match the withheld steps (got ${JSON.stringify(claude)})`);
	rec.check(report?.runtimes?.length === 1, `report: claude is the only runtime, since the refused Codex hook wrote nothing (got ${JSON.stringify(report?.runtimes?.map((row) => row.runtime))})`);
	rec.check((report?.notes ?? []).every((row) => row.decided === 0), "report: no note was decided for a withheld prompt");
	const noNote = report?.corrections?.rows?.find((row) => row.group === "no note");
	rec.check(report?.corrections?.kind === "counted" && report.corrections.records === 1 && noNote?.corrections === 1, `report: the fixture's correction joins its session (got ${JSON.stringify(report?.corrections)})`);
	rec.check(!json.stdout.includes("fixture words"), "report: no correction text is printed");
	const plain = rec.step("route-report-table", ["bun", agentic, "jev", "route-report", "--days", "1"], { cwd: fixture, env: { XDG_STATE_HOME: state } });
	rec.check(plain.status === 0 && plain.stdout.includes("(1 day)") && plain.stdout.includes("Correlation, not causation"), "report: the table form prints its window and labels corrections as correlation");
	const refused = rec.step("route-report-usage", ["bun", agentic, "jev", "route-report", "--days", "0"], { cwd: fixture, env: { XDG_STATE_HOME: state } });
	rec.check(refused.status === 2, `report: a bad window is a usage error (exit ${refused.status})`);
	rec.check(entries() === before, "report: the report writes nothing to the ledger");
}

function driveTaskRoute(run: RunInfo, rec: Recorder): void {
	const dir = runDir(run.runId);
	const state = join(dir, "state");
	const fixture = join(dir, "fixture");
	const hookCli = join(run.checkout, "agentic/tools/jev/cli.ts");
	const task = "Change how attempts are stored in the database so each one keeps its full test output";
	// A credential-shaped assignment, assembled here so no such literal sits in the repository.
	const unsafe = `Deploy with the ${"to"}${"ken"}=${"z".repeat(12)} from the vault`;
	const withheld: { id: string; prompt: string; route: string; cwd: string; fallbacks: string[] }[] = [
		{ id: "off", prompt: task, route: "off", cwd: fixture, fallbacks: ["off"] },
		{ id: "not-a-task", prompt: "ok", route: "", cwd: fixture, fallbacks: ["not-a-task"] },
		{ id: "system", prompt: "<task-notification> task finished", route: "", cwd: fixture, fallbacks: ["system"] },
		{ id: "unsafe-input", prompt: unsafe, route: "", cwd: fixture, fallbacks: ["unsafe-input"] },
		{ id: "opted-out", prompt: task, route: "", cwd: join(dir, "fixture-optout"), fallbacks: ["opted-out"] },
	];
	const kept: string[] = [];
	for (const c of withheld) {
		const session = `${run.runId}-${c.id}`;
		const file = `claude-${session}.jsonl`;
		const result = rec.step(`hook-${c.id}`, ["bun", hookCli, "task-class", "--claude-hook"], { cwd: c.cwd, env: { XDG_STATE_HOME: state, AGENTIC_ROUTE: c.route }, input: hookEvent(session, c.cwd, c.prompt) });
		rec.check(result.status === 0, `${c.id}: the hook exits 0 (got ${result.status})`);
		rec.check(result.stdout.trim() === "", `${c.id}: a withheld prompt adds no note`);
		const records = routeRecords(state, file);
		kept.push(...records.map((record) => JSON.stringify(record)));
		rec.check(records.length === 1, `${c.id}: exactly one record is written to ${file} (found ${records.length})`);
		const record = records[0];
		if (!record) continue;
		rec.check(sameList(record.fallbacks as string[] | undefined, c.fallbacks), `${c.id}: the record's fallbacks are exactly ${JSON.stringify(c.fallbacks)} (got ${JSON.stringify(record.fallbacks)})`);
		rec.check(record.answers === undefined, `${c.id}: no Jev answer is recorded`);
		if (c.id === "opted-out") rec.check(record.optedOut === true, "opted-out: the record marks the repository opted out");
		rec.check(!holdsPrompt(record, c.prompt), `${c.id}: the record holds no prompt text`);
	}
	// Codex support is gone: its hook flag is a usage error, with no note, no record, and no request.
	const codexSession = `${run.runId}-codex`;
	const routeFiles = () => (existsSync(join(state, "agentic", "task-route")) ? readdirSync(join(state, "agentic", "task-route"), { recursive: true }).length : 0);
	const filesBefore = routeFiles();
	const codex = rec.step("hook-codex-refused", ["bun", hookCli, "task-class", "--codex-hook"], { cwd: fixture, env: { XDG_STATE_HOME: state, AGENTIC_ROUTE: "" }, input: hookEvent(codexSession, fixture, task) });
	rec.check(codex.status === 2 && codex.stdout.trim() === "" && codex.stderr.includes("Usage: jev"), `codex: --codex-hook is a usage error with no output (exit ${codex.status})`);
	rec.check(routeFiles() === filesBefore && routeRecords(state, `codex-${codexSession}.jsonl`).length === 0, "codex: the refused hook writes no record");
	driveRouteReport(run, rec, state, fixture, kept.length);
	if (!typesafeKeyPresent()) {
		rec.note("records.jsonl", kept.join("\n") + "\n");
		return rec.skip("no TypeSafe key for the Jev steps: set TYPESAFE_API_KEY or, on macOS, add the keychain item typesafe-jev");
	}
	const session = `${run.runId}-jev`;
	const live = rec.step("hook-jev", ["bun", hookCli, "task-class", "--claude-hook"], { cwd: fixture, env: { XDG_STATE_HOME: state, AGENTIC_ROUTE: "" }, input: hookEvent(session, fixture, task) });
	rec.check(live.status === 0, `jev: the hook exits 0 (got ${live.status})`);
	const record = routeRecords(state, `claude-${session}.jsonl`)[0];
	rec.check(record !== undefined, "jev: a record is written");
	if (record) {
		kept.push(JSON.stringify(record));
		const answers = record.answers as { door?: { choice?: string }; level?: { choice?: string }; model?: string } | undefined;
		const fallbacks = (record.fallbacks as string[] | undefined) ?? [];
		rec.check(fallbacks.every((fallback) => ALLOWED_JEV_FALLBACKS.includes(fallback)), `jev: the request reached Jev; any fallback is a routing decision (${ALLOWED_JEV_FALLBACKS.join(", ")}), got ${JSON.stringify(record.fallbacks)}`);
		rec.check(["reversible", "experiment", "one-way-door"].includes(answers?.door?.choice ?? ""), `jev: the record holds Jev's door answer (${JSON.stringify(answers?.door?.choice)})`);
		rec.check(["lookup", "rigor", "loop"].includes(answers?.level?.choice ?? ""), `jev: the record holds Jev's level answer (${JSON.stringify(answers?.level?.choice)})`);
		rec.check(typeof answers?.model === "string" && answers.model.startsWith("jev-"), "jev: the record names the Jev model");
		const note = parseJson(live.stdout) as { hookSpecificOutput?: { additionalContext?: string } } | undefined;
		if (record.noted === true) rec.check(Boolean(note?.hookSpecificOutput?.additionalContext), "jev: a noted record answers with additionalContext");
		else rec.check(live.stdout.trim() === "", "jev: a record without a note answers nothing");
		rec.check(!holdsPrompt(record, task), "jev: the record holds no prompt text");
	}
	rec.note("records.jsonl", kept.join("\n") + "\n");
	const entries = () => readdirSync(state, { recursive: true }).length;
	const before = entries();
	const manual = rec.step("manual-route", ["bun", join(run.checkout, "agentic/bin/agentic"), "jev", "task-class", task], { cwd: fixture, env: { XDG_STATE_HOME: state, AGENTIC_ROUTE: "" } });
	const route = parseJson(manual.stdout.split("\n")[0] ?? "") as { advised?: { level?: string }; delivered?: { level?: string }; model?: string; fallbacks?: string[] } | undefined;
	rec.check(manual.status === 0 && typeof route?.model === "string" && route.model.startsWith("jev-") && Boolean(route.advised?.level) && Boolean(route.delivered?.level), "manual: agentic jev task-class prints the route Jev advised");
	rec.check(entries() === before, "manual: agentic jev task-class records nothing");
}

/** The real verdict ledger in the driven checkout's git common directory, as bytes (or absent). */
function realLedger(checkout: string): string {
	const common = git(["rev-parse", "--path-format=absolute", "--git-common-dir"], checkout);
	const file = join(common, "agentic", "orch", "ledger.tsv");
	return existsSync(file) ? createHash("sha256").update(readFileSync(file)).digest("hex") : "absent";
}

const BASELINE_RULES = ["deletion", "non_fast_forward", "required_linear_history"];
const BACKSTOP_SETTINGS = { name: "agentic-backstop", target: "branch", enforcement: "active", conditions: { ref_name: { include: ["~DEFAULT_BRANCH"], exclude: [] } }, bypass_actors: [] };
const VERDICTS = ["live-ui-verified", "unit-test-verified", "countersigned", "type-check-only", "verifier-blocked", "verifier-failed"];
const PASSING = ["live-ui-verified", "unit-test-verified", "countersigned"];
// Paths whose change sets the verification policy: a passing verdict other than a countersign is refused for them.
const POLICY_SAMPLES = [".agents/skills/verify-app/SKILL.md", ".agents/skills/verify-app/features/README.md", ".agents/skills/verify-app", ".agents/skills/verify-app/features", ".Agents/Skills/VERIFY-app/skill.md", ".claude/skills/verify-app", ".codex/skills/verify-app/SKILL.md", "skills/babysit-and-ship/SKILL.md", "skills/babysit-and-ship/references/shipping.md", "skills/babysit-and-ship/references/autopilot-full.md", "skills/babysit-and-ship/references/pr-body.md", "claude/agents/autopilot-owner.md", "agentic/tools/verify/cli.ts", "agentic/vendor/orch/store.ts", "agentic/bin/agentic"];
const NOT_POLICY_SAMPLES = [".agents/skills/verify-app/features/login.md", ".agents/skills/verify-app/scripts/verify-app", ".agents/skills/verify-app/scripts", ".agents/skills/other/SKILL.md", ".claude/skills/verify-app/scripts/verify-app", "claude/skills/verify-app", "skills/create-verification/SKILL.md", "claude/agents/build.md", "agentic/tools/verifyx/cli.ts", "agentic/tools/rulesets/cli.ts", "README.md"];
const isPolicySample = (path: string) => /^\.[^/]*\/skills\/verify-[^/]*(\/SKILL\.md|\/features(\/README\.md)?)?$|^skills\/babysit-and-ship\/(SKILL\.md$|references(\/|$))|^claude\/agents\/autopilot-owner\.md$|^agentic\/(tools\/verify|vendor\/orch)(\/|$)|^agentic\/bin\/agentic$/i.test(path);

/** A path as a diff header line writes it: C-quoted when git quotes it, with the tab git adds after a name holding a space. */
function diffHeaderPath(text: string): string {
	const bare = text.replace(/\t$/, "");
	if (!bare.startsWith('"')) return bare;
	// A quoted name ends in its own unescaped closing quote; one without it is unreadable, not shortened.
	const quoted = /^"((?:[^"\\]|\\.)*)"$/.exec(bare);
	if (!quoted) throw new Error(`cannot read the quoted diff path ${text}`);
	const escapes: Record<string, number> = { a: 7, b: 8, t: 9, n: 10, v: 11, f: 12, r: 13, '"': 34, "\\": 92 };
	const bytes: number[] = [];
	const body = quoted[1]!;
	for (let i = 0; i < body.length; i++) {
		if (body[i] !== "\\") {
			bytes.push(...Buffer.from(body[i]!, "utf8"));
			continue;
		}
		const octal = /^[0-7]{3}/.exec(body.slice(i + 1));
		if (octal) bytes.push(parseInt(octal[0], 8)), (i += 3);
		else if (body[i + 1]! in escapes) bytes.push(escapes[body[i + 1]!]!), (i += 1);
		else throw new Error(`cannot read the quoted diff path ${text}`);
	}
	return Buffer.from(bytes).toString("utf8");
}

/**
 * Every path a full git diff touches, old and new names alike (`gh pr diff --name-only` lists only a
 * rename's new name), read by this kit from the file headers only, never from hunk content. A header it
 * cannot read is an error, so the policy step fails closed rather than reading as "touches nothing".
 */
function diffPaths(diff: string): string[] {
	const paths = new Set<string>();
	let header: string | undefined;
	let found: string[] = [];
	const finish = () => {
		if (header === undefined) return;
		if (found.length === 0) {
			// Only a header with the same name on both sides (a mode change, a binary or empty file) names no path elsewhere.
			const rest = header.slice("diff --git ".length);
			const quoted = /^("(?:[^"\\]|\\.)*") ("(?:[^"\\]|\\.)*")$/.exec(rest);
			const [a, b] = quoted ? [diffHeaderPath(quoted[1]!), diffHeaderPath(quoted[2]!)] : [rest.slice(0, (rest.length - 1) / 2), rest.slice((rest.length + 1) / 2)];
			if (!a.startsWith("a/") || b !== `b/${a.slice(2)}`) throw new Error(`cannot read the changed path from the diff header: ${header}`);
			found.push(a.slice(2));
		}
		for (const path of found) paths.add(path);
		header = undefined;
		found = [];
	};
	for (const line of diff.split("\n")) {
		if (line.startsWith("diff --git ")) {
			finish();
			header = line;
			continue;
		}
		if (header === undefined) continue;
		if (line.startsWith("@@")) {
			finish();
			continue;
		}
		const named = /^(?:rename from|rename to|copy from|copy to) (.+)$/.exec(line);
		if (named) found.push(diffHeaderPath(named[1]!));
		const side = /^(?:---|\+\+\+) (.+)$/.exec(line);
		if (side && side[1] !== "/dev/null") {
			const path = diffHeaderPath(side[1]!);
			if (!/^[ab]\//.test(path)) throw new Error(`cannot read the changed path from the diff line: ${line}`);
			found.push(path.slice(2));
		}
	}
	finish();
	return [...paths];
}

function driveVerdictGate(run: RunInfo, rec: Recorder, options: Options): void {
	const agentic = join(run.checkout, "agentic/bin/agentic");
	// publish and --tier are gone: both must be usage errors that reach neither the ledger nor GitHub.
	for (const [name, argv] of [["verify-usage", ["verify"]], ["verify-publish-gone", ["verify", "publish", "1"]], ["rulesets-usage", ["rulesets"]], ["rulesets-tier-gone", ["rulesets", "plan", "o/r", "--tier", "merge-gate"]], ["pr-risk-usage", ["jev", "pr-risk", "0"]]] as const) {
		const usage = rec.step(name, ["bun", agentic, ...argv]);
		rec.check(usage.status === 2, `agentic ${argv.join(" ")} is a usage error, exit 2 (got ${usage.status})`);
	}
	// The gate's contract, checked by this kit against the driven checkout's own modules: a pull request
	// under test cannot loosen these expectations, because the verifier runs trunk's kit.
	const contract = rec.step("gate-contract", ["bun", "--eval", `
		const verify = await import(${JSON.stringify(join(run.checkout, "agentic/tools/verify/verify.ts"))});
		const rulesets = await import(${JSON.stringify(join(run.checkout, "agentic/tools/rulesets/rulesets.ts"))});
		const row = (sha, verdict, patch = "f1", evidence = "run.log") => ({ pr: 1, sha, verdict, evidence: verify.evidenceCell(evidence, patch), verifier: "v" });
		const at = (id, policyFiles = []) => () => ({ patchId: id, policyFiles });
		const desired = rulesets.desiredRuleset();
		const buildDiff = (line) => "diff --git a/build.sh b/build.sh\\nindex 0000001..0000002 100644\\n--- a/build.sh\\n+++ b/build.sh\\n@@ -1 +1 @@\\n-echo build\\n+" + line + "\\n";
		const renameOut = "diff --git a/.agents/skills/verify-app/SKILL.md b/notes.md\\nsimilarity index 100%\\nrename from .agents/skills/verify-app/SKILL.md\\nrename to notes.md\\n";
		const repoint = "diff --git a/.claude/skills/verify-app b/.claude/skills/verify-app\\nindex 3b18e51..5f1d0ec 120000\\n--- a/.claude/skills/verify-app\\n+++ b/.claude/skills/verify-app\\n@@ -1 +1 @@\\n-../../.agents/skills/verify-app\\n\\\\ No newline at end of file\\n+../../tools/lax\\n\\\\ No newline at end of file\\n";
		console.log(JSON.stringify({
			forgeExports: ["STATUS_CONTEXT", "statusFor"].filter((name) => name in verify).concat(["VERDICT_CONTEXT", "splitChecks"].filter((name) => name in rulesets)),
			verdicts: verify.VERDICTS,
			passes: Object.fromEntries(verify.VERDICTS.map((v) => [v, verify.passes(v)])),
			rules: desired.rules,
			settings: (({ name, target, enforcement, conditions, bypass_actors }) => ({ name, target, enforcement, conditions, bypass_actors }))(desired),
			settingsSame: rulesets.settingsDiff(${JSON.stringify(BACKSTOP_SETTINGS)}, desired),
			settingsLoose: rulesets.settingsDiff({ enforcement: "evaluate", bypass_actors: [{ actor_id: 1, actor_type: "OrganizationAdmin" }], conditions: { ref_name: { include: ["refs/heads/other"], exclude: [] } } }, desired),
			settingsDisabled: rulesets.settingsDiff({ ...${JSON.stringify(BACKSTOP_SETTINGS)}, enforcement: "disabled" }, desired),
			settingsBypass: rulesets.settingsDiff({ ...${JSON.stringify(BACKSTOP_SETTINGS)}, bypass_actors: [{ actor_id: 1, actor_type: "OrganizationAdmin" }] }, desired),
			settingsExcluded: rulesets.settingsDiff({ ...${JSON.stringify(BACKSTOP_SETTINGS)}, conditions: { ref_name: { include: ["~DEFAULT_BRANCH"], exclude: ["refs/heads/main"] } } }, desired),
			latestWins: verify.currentVerdict([{ pr: 1, sha: "a", verdict: "live-ui-verified" }, { pr: 1, sha: "a", verdict: "verifier-failed" }], 1, "a").state,
			laterPass: verify.currentVerdict([{ pr: 1, sha: "a", verdict: "verifier-failed" }, { pr: 1, sha: "a", verdict: "unit-test-verified" }], 1, "a").state,
			oldHead: verify.currentVerdict([{ pr: 1, sha: "b", verdict: "live-ui-verified" }], 1, "a").state,
			noRows: verify.currentVerdict([{ pr: 2, sha: "a", verdict: "live-ui-verified" }], 1, "a").state,
			rowForHead: verify.rowForHead([{ pr: 1, sha: "a", verdict: "first" }, { pr: 1, sha: "a", verdict: "second" }, { pr: 2, sha: "a", verdict: "other" }], 1, "a")?.verdict,
			unknown: [verify.isVerdict("passed"), verify.passes("passed")],
			gate: {
				none: verify.gate([], 1, "a", at("f1")).state,
				otherHead: verify.gate([row("b", "live-ui-verified")], 1, "a", at("f1")).state,
				failing: verify.gate([row("a", "verifier-blocked")], 1, "a", at("f1")).state,
				patchChanged: verify.gate([row("a", "live-ui-verified")], 1, "a", at("f2")).state,
				pass: verify.gate([row("a", "live-ui-verified")], 1, "a", at("f1")).state,
				countersigned: verify.gate([row("a", "countersigned")], 1, "a", at("f1")).state,
				policyPassing: verify.gate([row("a", "live-ui-verified")], 1, "a", at("f1", [".claude/skills/verify-app"])).state,
				policyCountersigned: verify.gate([row("a", "countersigned")], 1, "a", at("f1", [".claude/skills/verify-app"])).state,
			},
			countersign: {
				empty: verify.countersignable([], 1, "a", "f1"),
				blocked: verify.countersignable([row("a", "verifier-blocked")], 1, "a", "f1"),
				failed: verify.countersignable([row("a", "verifier-failed")], 1, "a", "f1"),
				typeCheck: verify.countersignable([row("a", "type-check-only")], 1, "a", "f1"),
				otherPatch: verify.countersignable([row("a", "verifier-blocked", "f0")], 1, "a", "f1"),
				carried: verify.countersignable([row("a", "verifier-blocked")], 1, "b", "f1"),
				headDecides: verify.countersignable([row("a", "verifier-blocked"), row("b", "verifier-failed")], 1, "b", "f1"),
			},
			approvedPatch: {
				named: verify.countersignEvidence([row("a", "verifier-blocked")], 1, "a", "f1", "f1", "msg"),
				unnamed: verify.countersignEvidence([row("a", "verifier-blocked")], 1, "a", "f1", undefined, "msg").ok,
				other: verify.countersignEvidence([row("a", "verifier-blocked")], 1, "a", "f1", "f0", "msg").ok,
				unblocked: verify.countersignEvidence([row("a", "type-check-only")], 1, "a", "f1", "f1", "msg").ok,
				carried: verify.countersignEvidence([row("a", "countersigned", "f1", "msg | verifier-blocked by v: run.log")], 1, "b", "f1", "f1", "carry"),
			},
			whitespace: [verify.patchIdOf(buildDiff("rm -rf /tmp/build")), verify.patchIdOf(buildDiff("rm -rf / tmp/build")), verify.patchIdOf(buildDiff("  rm -rf /tmp/build"))],
			policy: verify.policyFiles(${JSON.stringify([...POLICY_SAMPLES, ...NOT_POLICY_SAMPLES])}),
			renameOut: verify.policyFiles(verify.changedPaths(renameOut)),
			repoint: verify.policyFiles(verify.changedPaths(repoint)),
			repointRefused: verify.policyRefusal("live-ui-verified", verify.policyFiles(verify.changedPaths(repoint))) !== undefined,
			refusal: Object.fromEntries(verify.VERDICTS.map((v) => [v, verify.policyRefusal(v, ["agentic/tools/verify/cli.ts"]) !== undefined])),
			refusalClean: verify.policyRefusal("live-ui-verified", []) !== undefined,
		}));`]);
	const terms = parseJson(contract.stdout) as {
		forgeExports?: string[]; verdicts?: string[]; passes?: Record<string, boolean>; rules?: { type: string }[];
		settings?: unknown; settingsSame?: string[]; settingsLoose?: string[]; settingsDisabled?: string[]; settingsBypass?: string[]; settingsExcluded?: string[];
		latestWins?: string; laterPass?: string; oldHead?: string; noRows?: string; rowForHead?: string; unknown?: boolean[];
		gate?: Record<string, string>; countersign?: Record<string, boolean>;
		approvedPatch?: { named?: { ok: boolean; evidence?: string }; unnamed?: boolean; other?: boolean; unblocked?: boolean; carried?: { ok: boolean; evidence?: string } };
		whitespace?: string[]; policy?: string[]; renameOut?: string[]; repoint?: string[]; repointRefused?: boolean; refusal?: Record<string, boolean>; refusalClean?: boolean;
	} | undefined;
	rec.check(contract.status === 0 && terms !== undefined, `the gate's modules load in the driven checkout (exit ${contract.status})`);
	rec.check(sameList(terms?.forgeExports, []), `nothing mirrors a verdict to the forge: no status context, status builder, or required verdict check (found ${JSON.stringify(terms?.forgeExports)})`);
	rec.check(sameList(terms?.verdicts, VERDICTS), `the verdicts are exactly ${VERDICTS.join(", ")}`);
	rec.check(VERDICTS.every((v) => terms?.passes?.[v] === PASSING.includes(v)), `only ${PASSING.join(", ")} pass`);
	rec.check(sameList(terms?.rules?.map((rule) => rule.type), BASELINE_RULES), `the ruleset is exactly ${BASELINE_RULES.join(", ")}: no pull request or required checks`);
	rec.check(canonical(terms?.settings) === canonical(BACKSTOP_SETTINGS), `the ruleset is ${canonical(BACKSTOP_SETTINGS)} (got ${canonical(terms?.settings)})`);
	const reports = (got: string[] | undefined, wanted: string[]) => got !== undefined && wanted.every((setting) => got.includes(setting));
	rec.check(sameList(terms?.settingsSame, []), `the plan reports nothing for the desired settings (got ${JSON.stringify(terms?.settingsSame)})`);
	rec.check(reports(terms?.settingsLoose, ["enforcement", "bypass_actors", "conditions"]) && reports(terms?.settingsDisabled, ["enforcement"]) && reports(terms?.settingsBypass, ["bypass_actors"]) && reports(terms?.settingsExcluded, ["conditions"]), "the plan reports evaluate or disabled enforcement, a bypass actor on an active ruleset, another branch, and an excluded branch as settings to change");
	rec.check(terms?.latestWins === "fail" && terms.laterPass === "pass" && terms.oldHead === "void" && terms.noRows === "none" && terms.rowForHead === "second", "the latest verdict for the head decides, and a verdict for an old head is void");
	rec.check(sameList(terms?.unknown?.map(String), ["false", "false"]), "a verdict outside the list is neither recognized nor passing");
	const g = terms?.gate;
	rec.check(g?.none === "none" && g.otherHead === "void" && g.failing === "fail" && g.patchChanged === "void" && g.pass === "pass" && g.countersigned === "pass" && g.policyPassing === "fail" && g.policyCountersigned === "pass", `the local gate passes only a passing verdict for the head with an unchanged patch, and for a diff that touches a policy path only a countersign (got ${JSON.stringify(g)})`);
	const c = terms?.countersign;
	rec.check(c?.empty === false && c.blocked === true && c.failed === false && c.typeCheck === false && c.otherPatch === false && c.carried === true && c.headDecides === false, `a countersign needs a verifier-blocked verdict for the same patch, the head's own row deciding (got ${JSON.stringify(c)})`);
	const a = terms?.approvedPatch;
	rec.check(a?.named?.ok === true && a.named.evidence === "msg | verifier-blocked by v: run.log" && a.unnamed === false && a.other === false && a.unblocked === false && a.carried?.ok === true && a.carried.evidence === "carry | verifier-blocked by v: run.log", `a countersign must name the current patch as the approved one, and its evidence carries the blocked verdict's verifier and evidence, also when carried (got ${JSON.stringify(a)})`);
	const w = terms?.whitespace;
	rec.check(w?.length === 3 && w.every((id) => /^[0-9a-f]{40}$/.test(id)) && new Set(w).size === 3, `the patch ID keeps whitespace: "rm -rf /tmp/build", "rm -rf / tmp/build", and a re-indented line get three IDs (got ${JSON.stringify(w)})`);
	rec.check(sameList(terms?.policy, POLICY_SAMPLES), `the policy paths cover a verification skill's verdict rules (SKILL.md, features/README.md, and a file at the skill's or features' own name, under .agents/skills or any runtime's dot-directory skills) and the landing gate, but not its feature files or drive scripts, and nothing else sampled (got ${JSON.stringify(terms?.policy)})`);
	rec.check(sameList(terms?.renameOut, [".agents/skills/verify-app/SKILL.md"]), `a rename of a verification skill's SKILL.md out of its directory touches a policy path (got ${JSON.stringify(terms?.renameOut)})`);
	rec.check(sameList(terms?.repoint, [".claude/skills/verify-app"]) && terms?.repointRefused === true, `repointing a runtime's discovery symlink (.claude/skills/verify-app) from the verification skill to another directory touches a policy path, and live-ui-verified is refused for it (got ${JSON.stringify(terms?.repoint)}, refused ${terms?.repointRefused})`);
	rec.check(VERDICTS.every((v) => terms?.refusal?.[v] === (PASSING.includes(v) && v !== "countersigned")) && terms?.refusalClean === false, `for a policy change, record refuses exactly the passing verdicts but countersigned, and nothing for a change that touches no policy path (got ${JSON.stringify(terms?.refusal)}, clean ${terms?.refusalClean})`);

	if (!ghReady()) return rec.skip("gh is not logged in for the GitHub steps: run gh auth login");
	const slug = options.slug ?? originSlug(run.checkout);
	if (!slug) return rec.skip("the driven checkout has no GitHub origin: pass --repo owner/name");

	// The plan is a dry run: observe that the live ruleset is unchanged, and check the plan against it.
	const liveRuleset = (): string => {
		const id = (ghJson(`repos/${slug}/rulesets`) as { id: number; name: string }[]).find((ruleset) => ruleset.name === "agentic-backstop")?.id;
		return id === undefined ? "none" : JSON.stringify(ghJson(`repos/${slug}/rulesets/${id}`));
	};
	const rulesetBefore = liveRuleset();
	const liveState = rulesetBefore === "none" ? undefined : (JSON.parse(rulesetBefore) as { enforcement?: string; bypass_actors?: unknown[]; conditions?: { ref_name?: { include?: string[]; exclude?: string[] } }; rules: { type: string }[] });
	const types = (liveState?.rules ?? []).map((rule) => rule.type);
	const sorted = (list: readonly string[] | undefined) => JSON.stringify([...(list ?? [])].sort());
	const expectSettings = liveState === undefined ? [] : [
		...(liveState.enforcement !== BACKSTOP_SETTINGS.enforcement ? ["~enforcement"] : []),
		...(JSON.stringify(liveState.bypass_actors ?? null) !== JSON.stringify(BACKSTOP_SETTINGS.bypass_actors) ? ["~bypass_actors"] : []),
		...(sorted(liveState.conditions?.ref_name?.include) !== sorted(BACKSTOP_SETTINGS.conditions.ref_name.include) || sorted(liveState.conditions?.ref_name?.exclude) !== sorted(BACKSTOP_SETTINGS.conditions.ref_name.exclude) ? ["~conditions"] : []),
	];
	rec.note("ruleset-before.json", rulesetBefore + "\n");
	const plan = rec.step("rulesets-plan", ["bun", agentic, "rulesets", "plan", slug]);
	const line = plan.stdout.split("\n").find((text) => text.startsWith(`${slug} (`)) ?? "";
	const changes = /changes (.+)$/.exec(line)?.[1]?.split(" ") ?? [];
	const expectAdd = BASELINE_RULES.filter((type) => !types.includes(type)).map((type) => `+${type}`);
	const expectRemove = types.filter((type) => !BASELINE_RULES.includes(type)).map((type) => `-${type}`);
	rec.check(plan.status === 0 && line !== "" && !line.includes("tier"), `rulesets plan prints its plan for ${slug} with no tier (exit ${plan.status})`);
	rec.check(sameList(changes.filter((change) => change.startsWith("+")).sort(), expectAdd.sort()) && sameList(changes.filter((change) => change.startsWith("-")).sort(), expectRemove.sort()), `rulesets plan adds ${JSON.stringify(expectAdd)} and removes ${JSON.stringify(expectRemove)} against the live ruleset (printed "${line}")`);
	rec.check(sameList(changes.filter((change) => change.startsWith("~")).sort(), [...expectSettings].sort()), `rulesets plan changes exactly the settings ${JSON.stringify(expectSettings)} against the live ruleset (printed "${line}")`);
	rec.check(!plan.stdout.includes("required checks"), "rulesets plan names no required checks");
	rec.check(liveRuleset() === rulesetBefore, `the live ruleset on ${slug} is unchanged after the plan`);

	const merged = options.mergedPr ?? newestPr(slug, "merged");
	if (merged === undefined) return rec.skip(`no merged pull request in ${slug}: pass --merged-pr N`);
	const store = join(runDir(run.runId), "orch");
	const env = { AGENTIC_ORCH_STORE: store, AGENTIC_AGENT_ID: `verify-agent-kit-smoke-${run.runId}` };
	const ledgerBefore = realLedger(run.checkout);
	const status = rec.step("verify-status-merged", ["bun", agentic, "verify", "status", String(merged), "--repo", slug], { env });
	rec.check(status.status === 1 && status.stdout.startsWith(`${slug}#${merged} (MERGED,`) && status.stdout.includes("ledger none") && !status.stdout.includes("forge"), `verify status on merged #${merged} reports an empty ledger and no forge state, exit 1 (got ${status.status})`);
	// Every record runs from this run's fixture repository (with --repo naming the real one), so even a CLI
	// that ignored AGENTIC_ORCH_STORE would write the fixture's ledger, never the real one.
	const fixture = join(runDir(run.runId), "fixture");
	const refused = rec.step("verify-record-merged", ["bun", agentic, "verify", "record", String(merged), "--repo", slug, "--verdict", "type-check-only", "--evidence", rec.dir], { env, cwd: fixture });
	rec.check(refused.status === 1 && refused.stderr.includes("verdicts are for open pull requests"), `verify record refuses merged #${merged} (exit ${refused.status})`);
	rec.check(!existsSync(join(store, "ledger.tsv")), "a refused record writes no ledger");

	if (typesafeKeyPresent()) {
		const risk = rec.step("pr-risk-merged", ["bun", agentic, "jev", "pr-risk", String(merged), "--repo", slug]);
		const match = new RegExp(`^${slug.replace(/[.]/g, "\\.")}#${merged}: (low|high), P\\(one-way door\\) (\\d\\.\\d\\d) (<=|>) 0\\.3$`).exec(risk.stdout.trim());
		rec.check(match !== null, `jev pr-risk scores merged #${merged} with Jev's probability (printed "${risk.stdout.trim()}")`);
		if (match) {
			// The printed P is rounded to two places, so at exactly 0.30 either decision is possible.
			const p = Number(match[2]);
			const above = match[1] === "high";
			rec.check((p === 0.3 || above === p > 0.3) && match[3] === (above ? ">" : "<=") && risk.status === (above ? 3 : 0), `jev pr-risk marks a score above 0.3 high, exit 3, and one at or below it low, exit 0 (printed P ${match[2]}, ${match[1]}, exit ${risk.status})`);
		}
	} else rec.skip("no TypeSafe key for jev pr-risk: set TYPESAFE_API_KEY or, on macOS, add the keychain item typesafe-jev");

	const open = options.pr ?? newestPr(slug, "open");
	if (open === undefined) {
		rec.check(realLedger(run.checkout) === ledgerBefore, "the real verdict ledger is unchanged");
		return rec.skip(`no open pull request in ${slug} to record a smoke verdict for: pass --pr N`);
	}
	const head = JSON.parse(ghText(["pr", "view", String(open), "-R", slug, "--json", "headRefOid,state"])) as { headRefOid?: string; state?: string };
	if (head.state !== "OPEN") throw new Error(`#${open} in ${slug} is not open (state ${head.state ?? "unknown"}); pass --pr with an open pull request`);
	if (options.pr !== undefined) rec.check(head.headRefOid === run.revision, `the driven checkout is at #${open}'s head (checkout ${run.revision.slice(0, 12)}, head ${head.headRefOid?.slice(0, 12)}); verify a worktree at the head`);
	else rec.note("smoke-only.txt", `#${open} was picked as the newest open pull request; the driven checkout (${run.revision}) is not necessarily its head, so this record is a ledger smoke check, not evidence about #${open}.\n`);
	// Every verdict this drive records never passes, and every countersign it attempts must be refused;
	// all of them run from the fixture repository, as above.
	const evidence = join(rec.dir, "verdict-evidence.txt");
	writeFileSync(evidence, `verify-agent-kit verdict-gate smoke verdict for ${slug}#${open} in run ${run.runId}; ledger at ${store}\n`);
	const ledgerFile = join(store, "ledger.tsv");
	const ledgerText = () => (existsSync(ledgerFile) ? readFileSync(ledgerFile, "utf8") : "");
	const diff = ghText(["pr", "diff", String(open), "-R", slug]);
	const patch = sh(["git", "patch-id", "--verbatim"], { cwd: KIT_CHECKOUT, input: diff }).stdout.split(" ")[0] ?? "";
	rec.check(/^[0-9a-f]{40}$/.test(patch), `the open pull request's patch ID is computed from its diff (got "${patch}")`);
	const countersign = (name: string, approved: string) => rec.step(name, ["bun", agentic, "verify", "record", String(open), "--repo", slug, "--verdict", "countersigned", "--patch", approved, "--evidence", evidence], { env, cwd: fixture });
	const unsigned = countersign("verify-countersign-unverified", patch);
	rec.check(unsigned.status === 1 && unsigned.stderr.includes("no verifier-blocked verdict covers patch") && !existsSync(ledgerFile), `verify record refuses a countersign for open #${open} with no verifier-blocked verdict, and writes no ledger (exit ${unsigned.status})`);
	const recorded = rec.step("verify-record-open", ["bun", agentic, "verify", "record", String(open), "--repo", slug, "--verdict", "type-check-only", "--evidence", evidence], { env, cwd: fixture });
	rec.check(recorded.status === 0 && recorded.stdout.includes(`recorded type-check-only on ${head.headRefOid?.slice(0, 12)}`) && !recorded.stdout.includes("publish"), `verify record writes the smoke verdict for open #${open} and names no publish step (exit ${recorded.status})`);
	const ledger = ledgerText();
	rec.note("ledger.tsv", ledger);
	const row = ledger.split("\n").filter(Boolean).at(-1)?.split("\t") ?? [];
	rec.check(row.includes(String(open)) && row.includes(head.headRefOid ?? "?") && row.includes(env.AGENTIC_AGENT_ID) && row.some((cell) => cell.endsWith(` patch:${patch}`)), "the run's ledger row binds the PR, its head SHA, the patch ID, and the verifier ID");
	const overTypeCheck = countersign("verify-countersign-over-type-check", patch);
	rec.check(overTypeCheck.status === 1 && overTypeCheck.stderr.includes("no verifier-blocked verdict covers patch") && ledgerText() === ledger, `verify record refuses a countersign over a type-check-only verdict for #${open}, and the ledger is unchanged (exit ${overTypeCheck.status})`);
	const gateStatus = rec.step("verify-status-open", ["bun", agentic, "verify", "status", String(open), "--repo", slug], { env });
	rec.check(gateStatus.status === 1 && gateStatus.stdout.includes("ledger fail (type-check-only") && gateStatus.stdout.includes(`at ${head.headRefOid?.slice(0, 12)}`) && !gateStatus.stdout.includes("forge"), `the local gate reads the non-passing smoke verdict back for #${open}'s head and refuses, exit 1`);
	// Over a verifier-blocked verdict, a countersign naming a patch the user was never shown is refused.
	const blocked = rec.step("verify-record-blocked", ["bun", agentic, "verify", "record", String(open), "--repo", slug, "--verdict", "verifier-blocked", "--evidence", evidence], { env, cwd: fixture });
	rec.check(blocked.status === 0 && blocked.stdout.includes(`recorded verifier-blocked on ${head.headRefOid?.slice(0, 12)}`), `verify record writes a verifier-blocked smoke verdict for #${open} (exit ${blocked.status})`);
	const blockedLedger = ledgerText();
	rec.note("ledger-blocked.tsv", blockedLedger);
	const unapproved = countersign("verify-countersign-other-patch", "0".repeat(40));
	rec.check(unapproved.status === 1 && unapproved.stderr.includes("a changed patch needs new words from the user") && ledgerText() === blockedLedger, `verify record refuses a countersign over verifier-blocked whose --patch is not #${open}'s current patch, and the ledger is unchanged (exit ${unapproved.status})`);
	// A passing verdict for a pull request that touches a policy path is refused; attempted only when it does,
	// so this drive never records a passing verdict that record would accept.
	// Read from the full diff's old and new names, so a rename out of a policy path still counts.
	const rename = "diff --git a/.agents/skills/verify-app/SKILL.md b/notes.md\nsimilarity index 100%\nrename from .agents/skills/verify-app/SKILL.md\nrename to notes.md\n";
	rec.check(sameList(diffPaths(rename).filter(isPolicySample), [".agents/skills/verify-app/SKILL.md"]), "the kit reads a renamed file's old name from a diff, so a rename out of a policy path counts as touching it");
	const unclosed = 'diff --git "a/x y" "b/x y"\n--- "a/x y\n+++ "b/x y"\n';
	const unclosedRefused = (() => {
		try {
			diffPaths(unclosed);
			return false;
		} catch {
			return true;
		}
	})();
	rec.check(unclosedRefused, "the kit refuses a quoted diff name without its closing quote rather than reading it shortened");
	const changed = diffPaths(diff);
	const policyTouched = changed.filter(isPolicySample);
	rec.note("changed-paths.txt", `${changed.join("\n")}\n`);
	rec.note("policy-files.txt", `${policyTouched.join("\n")}\n`);
	if (policyTouched.length > 0) {
		const passing = rec.step("verify-record-policy-passing", ["bun", agentic, "verify", "record", String(open), "--repo", slug, "--verdict", "unit-test-verified", "--evidence", evidence], { env, cwd: fixture });
		rec.check(passing.status === 1 && passing.stderr.includes("changes the verification policy") && passing.stderr.includes("countersigned") && ledgerText() === blockedLedger, `verify record refuses unit-test-verified for #${open}, which touches ${policyTouched.length} policy path(s), names the countersign route, and leaves the ledger unchanged (exit ${passing.status})`);
	} else rec.note("policy-passing-skipped.txt", `#${open} touches no policy path, so the passing-verdict refusal is not attempted: record would accept it.\n`);
	const blockedStatus = rec.step("verify-status-blocked", ["bun", agentic, "verify", "status", String(open), "--repo", slug], { env });
	rec.check(blockedStatus.status === 1 && blockedStatus.stdout.includes("ledger fail (verifier-blocked"), `the local gate refuses the verifier-blocked smoke verdict for #${open}, exit 1`);
	rec.check(!existsSync(join(git(["rev-parse", "--path-format=absolute", "--git-common-dir"], fixture), "agentic", "orch", "ledger.tsv")), "the fixture repository's ledger stayed empty: every record used this run's store");
	rec.check(realLedger(run.checkout) === ledgerBefore, "the real verdict ledger is unchanged: every verdict went to this run's store");
}

function drivePrState(run: RunInfo, rec: Recorder, options: Options): void {
	const agentic = join(run.checkout, "agentic/bin/agentic");
	const usage = rec.step("pr-feedback-usage", ["bun", agentic, "pr-feedback", "--no-such-flag"]);
	rec.check(usage.status === 2, `pr-feedback with an unknown flag is a usage error, exit 2 (got ${usage.status})`);
	if (!ghReady()) return rec.skip("gh is not logged in for the GitHub steps: run gh auth login");
	const slug = options.slug ?? originSlug(run.checkout);
	if (!slug) return rec.skip("the driven checkout has no GitHub origin: pass --repo owner/name");
	const [owner, name] = slug.split("/") as [string, string];
	const merged = options.mergedPr ?? newestPr(slug, "merged");
	if (merged === undefined) return rec.skip(`no merged pull request in ${slug}: pass --merged-pr N`);

	const text = rec.step("pr-feedback-merged", ["bun", agentic, "pr-feedback", String(merged), "--repo", slug]);
	rec.check(text.status === 0 && text.stdout.startsWith(`# PR #${merged}:`) && text.stdout.includes("PR is MERGED") && text.stdout.includes("## Blockers") && text.stdout.includes("## Retrieval gaps"), `pr-feedback prints merged #${merged}'s state, blockers, and gaps (exit ${text.status})`);
	const json = rec.step("pr-feedback-merged-json", ["bun", agentic, "pr-feedback", String(merged), "--repo", slug, "--json"]);
	const parsed = parseJson(json.stdout) as { number?: number; state?: string; readiness?: string; headSha?: string } | undefined;
	const truth = ghJson(`repos/${slug}/pulls/${merged}`) as { head: { sha: string }; merged: boolean };
	rec.check(json.status === 0 && parsed?.number === merged && parsed.state === "MERGED" && truth.merged && parsed.headSha === truth.head.sha, `pr-feedback --json describes merged #${merged} with the head SHA GitHub reports`);
	const table = rec.step("watch-pr-merged", ["bun", agentic, "watch-pr", "--owner", owner, "--repo", name, "--pr", String(merged), "--status-only", "--pretty"]);
	rec.check(table.status === 0 && table.stdout.includes(`#${merged}`) && table.stdout.includes("merged"), `watch-pr --status-only --pretty shows #${merged} merged`);
	const watch = rec.step("watch-pr-merged-json", ["bun", agentic, "watch-pr", "--owner", owner, "--repo", name, "--pr", String(merged), "--status-only"]);
	const status = parseJson(watch.stdout.trim().split("\n")[0] ?? "") as { kind?: string; rows?: { facts?: { state?: string; headRefOid?: string } }[] } | undefined;
	rec.check(watch.status === 0 && status?.kind === "STATUS" && status.rows?.[0]?.facts?.state === "MERGED" && status.rows[0].facts.headRefOid === truth.head.sha, `watch-pr --status-only JSON reports #${merged} MERGED at GitHub's head SHA`);

	const open = options.pr ?? newestPr(slug, "open");
	if (open === undefined) return rec.skip(`no open pull request in ${slug}: pass --pr N to read one`);
	const openTruth = ghJson(`repos/${slug}/pulls/${open}`) as { head: { sha: string }; state: string };
	const openJson = rec.step("pr-feedback-open-json", ["bun", agentic, "pr-feedback", String(open), "--repo", slug, "--json"]);
	const openParsed = parseJson(openJson.stdout) as { number?: number; state?: string; headSha?: string } | undefined;
	rec.check(openJson.status === 0 && openParsed?.state === "OPEN" && openParsed.headSha === openTruth.head.sha, `pr-feedback --json reads open #${open} at GitHub's head SHA`);
	const openWatch = rec.step("watch-pr-open-json", ["bun", agentic, "watch-pr", "--owner", owner, "--repo", name, "--pr", String(open), "--status-only"]);
	const openStatus = parseJson(openWatch.stdout.trim().split("\n")[0] ?? "") as { rows?: { facts?: { state?: string; headRefOid?: string } }[] } | undefined;
	rec.check(openWatch.status === 0 && openStatus?.rows?.[0]?.facts?.state === "OPEN" && openStatus.rows[0].facts.headRefOid === openTruth.head.sha, `watch-pr --status-only JSON reports #${open} OPEN at GitHub's head SHA`);
}

function frontmatter(path: string): Map<string, string> {
	const block = /^---\n([\s\S]*?)\n---\n/.exec(readFileSync(path, "utf8"))?.[1] ?? "";
	const fields = new Map<string, string>();
	for (const line of block.split("\n")) {
		const at = line.indexOf(":");
		if (at > 0 && !/^\s/.test(line)) fields.set(line.slice(0, at).trim(), line.slice(at + 1).trim());
	}
	return fields;
}

function driveSkillCatalog(run: RunInfo, rec: Recorder): void {
	const root = run.checkout;
	const check = rec.step("check-skills", ["bun", "scripts/check-skills.ts"]);
	rec.check(check.status === 0, `scripts/check-skills.ts passes (exit ${check.status})`);
	const rows: string[] = ["runtime\tskill\tpath\tinvocation\tdescription_chars"];
	const add = (runtime: string, directory: string) => {
		const file = join(root, directory, "SKILL.md");
		if (!rec.check(existsSync(file), `${runtime} export ${directory} has a SKILL.md`)) return;
		const fields = frontmatter(file);
		rec.check(fields.get("name") === basename(directory), `${runtime} export ${directory} is named after its directory`);
		rows.push([runtime, fields.get("name"), directory, fields.get("disable-model-invocation") === "true" ? "user-only" : "model-and-user", String((fields.get("description") ?? "").length)].join("\t"));
	};
	const lines = (path: string) => readFileSync(join(root, path), "utf8").split("\n").map((line) => line.trim()).filter(Boolean);
	for (const entry of lines("claude/skills.txt")) add("claude", entry);
	const pkg = JSON.parse(readFileSync(join(root, "package.json"), "utf8")) as { pi?: { skills?: string[] } };
	for (const directory of pkg.pi?.skills ?? []) {
		for (const name of readdirSync(join(root, directory)).sort()) if (existsSync(join(root, directory, name, "SKILL.md"))) add("pi", join(directory, name).replace(/^\.\//, ""));
	}
	for (const name of readdirSync(join(root, ".agents/skills")).sort()) {
		add("repo", `.agents/skills/${name}`);
		const link = join(root, ".claude/skills", name, "SKILL.md");
		rec.check(existsSync(link) && readFileSync(link, "utf8") === readFileSync(join(root, ".agents/skills", name, "SKILL.md"), "utf8"), `.claude/skills/${name} resolves to .agents/skills/${name} so Claude Code finds it`);
	}
	rec.note("exports.tsv", rows.join("\n") + "\n");
	const roles: string[] = ["role\tmodel\teffort\ttools\tdisallowed"];
	for (const entry of readdirSync(join(root, "claude/agents")).filter((name) => name.endsWith(".md")).sort()) {
		const fields = frontmatter(join(root, "claude/agents", entry));
		rec.check(Boolean(fields.get("name")) && Boolean(fields.get("description")), `role ${entry} has a name and a description`);
		rec.check((fields.get("model") ?? "").startsWith("claude-"), `role ${entry} binds a Claude model (got ${fields.get("model") ?? "none"})`);
		roles.push([fields.get("name"), fields.get("model"), fields.get("effort") ?? "", fields.get("tools") ?? "(all)", fields.get("disallowedTools") ?? ""].join("\t"));
	}
	rec.note("roles.tsv", roles.join("\n") + "\n");
	rec.check(rows.length > 1 && roles.length > 1, "the catalog lists at least one skill and one role");
}

function driveClaudeSurface(run: RunInfo, rec: Recorder): void {
	const statusline = join(run.checkout, "claude/statusline.ts");
	const now = Math.floor(Date.now() / 1000);
	const quota = JSON.stringify({ rate_limits: { five_hour: { used_percentage: 42.4, resets_at: now + 5400 }, seven_day: { used_percentage: 7, resets_at: now + 200_000 } } });
	const shown = rec.step("statusline-quota", ["bun", statusline], { input: quota });
	rec.check(shown.status === 0 && /^claude 5h ▄ 42% ↻1h(29|30)m · 7d ▁ 7% ↻2d7h$/.test(shown.stdout.trim()), `the status line renders both windows with gauges and countdowns (got "${shown.stdout.trim()}")`);
	const missing = rec.step("statusline-no-limits", ["bun", statusline], { input: "{}" });
	rec.check(missing.status === 0 && missing.stdout.trim() === "claude limits: n/a", "the status line shows n/a without rate limits");
	const invalid = rec.step("statusline-invalid", ["bun", statusline], { input: "not json" });
	rec.check(invalid.status === 0 && invalid.stdout.trim() === "claude limits: n/a", "the status line shows n/a for invalid input");
	const claude = Bun.which("claude");
	if (!claude) return rec.skip("the claude CLI is not on PATH for the Mod steps: install Claude Code");
	const mod = join(run.checkout, "claude/mods/trial-tools");
	const before = git(["status", "--porcelain=v1", "-uall"], run.checkout);
	const env = { CLAUDE_CODE_ENABLE_FUNCTION_HOOKS: "1" };
	const validate = rec.step("mod-validate", [claude, "plugin", "validate", "--strict", mod], { env });
	rec.check(validate.status === 0 && (validate.stdout + validate.stderr).includes("Validation passed"), `claude plugin validate --strict passes for trial-tools (exit ${validate.status})`);
	const test = rec.step("mod-test", [claude, "plugin", "test", mod], { env });
	const summary = /(\d+) pass\s+(\d+) fail/.exec(test.stdout + test.stderr);
	rec.check(test.status === 0 && summary !== null && Number(summary[1]) > 0 && summary[2] === "0", `claude plugin test runs the Mod's native tests with no failures (${summary ? `${summary[1]} pass, ${summary[2]} fail` : `exit ${test.status}`})`);
	rec.check(git(["status", "--porcelain=v1", "-uall"], run.checkout) === before, "driving the Mod leaves the checkout's tracked and untracked files unchanged");
}

/** A Claude Code PreToolUse event for a tool, from the main session or from a subagent. */
function preToolUseEvent(runId: string, cwd: string, input: Record<string, unknown>, agent?: { id: string; type?: string }, tool = "Bash"): string {
	return JSON.stringify({
		session_id: `${runId}-git-guard`,
		transcript_path: "/dev/null",
		cwd,
		permission_mode: "bypassPermissions",
		hook_event_name: "PreToolUse",
		tool_name: tool,
		tool_input: { description: "verify-agent-kit git-guard case", ...input },
		tool_use_id: "toolu_verify_agent_kit",
		...(agent ? { agent_id: agent.id, ...(agent.type === undefined ? {} : { agent_type: agent.type }) } : {}),
	});
}

/** A scratch git repository whose bunfig.toml preloads a script that prints, as an ordinary Bun project's might. */
function guardProject(run: RunInfo): string {
	const project = join(runDir(run.runId), "git-guard-project");
	mkdirSync(project, { recursive: true });
	git(["init", "-q", "-b", "main"], project);
	writeFileSync(join(project, "preload.ts"), 'console.log("project preload ran");\n');
	writeFileSync(join(project, "bunfig.toml"), 'preload = ["./preload.ts"]\n');
	return project;
}

function driveGitGuard(run: RunInfo, rec: Recorder): void {
	const project = guardProject(run);
	const hookCli = join(run.checkout, "agentic/tools/git-guard/cli.ts");
	// The documented command: --cwd keeps Bun from loading the project's bunfig.toml.
	const hook = ["bun", "--cwd", run.checkout, hookCli];
	const worker = { id: "a-verify-worker", type: "general-purpose" };
	const owner = { id: "a-verify-owner", type: "autopilot-owner" };
	const event = (command: string, agent?: { id: string; type?: string }, tool?: string) => preToolUseEvent(run.runId, project, { command }, agent, tool);
	const skip = /skipping git hooks/;
	const hooksKey = /skipping git hooks by setting or unsetting core\.hooksPath or a hook\.\* key/;
	const cases: { id: string; stdin: string; deny?: RegExp }[] = [
		{ id: "main-push", stdin: event("git push origin main") },
		{ id: "main-no-verify", stdin: event("git commit --allow-empty --no-verify -m probe"), deny: skip },
		{ id: "main-mention", stdin: event("git commit -m \"docs: explain why --no-verify is refused\""), deny: /skipping git hooks with --no-verify.*only mentions the flag.*git commit -F <file>/ },
		{ id: "main-commit-file", stdin: event("git commit -F .git/COMMIT_MSG_DRAFT") },
		{ id: "main-commit-n", stdin: event("git commit --allow-empty -nm probe"), deny: /skipping git hooks with -n/ },
		{ id: "main-n-mention", stdin: event("git commit -m \"fix -n handling\""), deny: /skipping git hooks with -n.*only mentions it.*git commit -F <file>/ },
		{ id: "main-flag-message", stdin: event("git commit -m \"Build with -fno-exceptions\"") },
		{ id: "main-long-option-typo", stdin: event("git commit -m \"Pass -include to clang\"") },
		{ id: "main-heredoc-no-verify", stdin: event("git commit -m \"$(cat <<'EOF'\nDon't skip hooks\nEOF\n)\" --no-verify"), deny: /skipping git hooks with --no-verify/ },
		{ id: "main-skip-variable", stdin: event("HUSKY=0 git commit --allow-empty -m probe"), deny: /skipping git hooks with a hook manager's skip variable/ },
		{ id: "main-exported-skip", stdin: event("export SKIP=lint && git commit --allow-empty -m probe"), deny: /skipping git hooks with a hook manager's skip variable/ },
		{ id: "main-am-n", stdin: event("git am -n < 0001-fix.patch"), deny: /skipping git hooks with -n/ },
		{ id: "main-heredoc-to-sh", stdin: event("cat <<'EOF' | sh\ngit commit --allow-empty -n -m probe\nEOF"), deny: /skipping git hooks with -n/ },
		{ id: "main-hooks-override", stdin: event("git -c core.hooksPath=/dev/null commit --allow-empty -m probe"), deny: hooksKey },
		{ id: "main-hooks-config", stdin: event("git config core.hooksPath /dev/null"), deny: hooksKey },
		{ id: "main-hooks-unset", stdin: event("git config --unset core.hooksPath"), deny: hooksKey },
		{ id: "main-hook-key-override", stdin: event("git -c hook.pre-commit.enabled=false commit --allow-empty -m probe"), deny: hooksKey },
		{ id: "main-hook-key-write", stdin: event("git config hook.pre-commit.enabled false"), deny: hooksKey },
		{ id: "main-remove-section", stdin: event("git config remove-section hook.lint"), deny: hooksKey },
		{ id: "main-hooks-read", stdin: event("git config --get core.hooksPath") },
		{ id: "main-hooks-read-redirect", stdin: event("git config core.hooksPath 2>/dev/null || echo unset") },
		{ id: "main-config-user", stdin: event("git config user.name probe") },
		{ id: "main-absolute-no-verify", stdin: event("/usr/bin/git commit --allow-empty --no-verify -m probe"), deny: skip },
		{ id: "main-am", stdin: event("git am patch") },
		{ id: "main-gh-merge", stdin: event("gh pr merge 3 --squash") },
		{ id: "main-pipe-to-sh", stdin: event("printf 'echo hi\\n' | sh") },
		{ id: "main-shell-no-input", stdin: event("bash -l") },
		{ id: "main-unclosed-quote", stdin: event("echo \"unterminated") },
		{ id: "subagent-push", stdin: event("git push origin agent/x", worker), deny: /child publication\/integration command: git push/ },
		{ id: "subagent-rebase", stdin: event("cd sub && git -C . rebase origin/main", worker), deny: /child publication\/integration command: git rebase/ },
		{ id: "subagent-tag", stdin: event("git tag v1", worker), deny: /child publication\/integration command: git tag/ },
		{ id: "subagent-monitor-push", stdin: event("git push origin agent/x", worker, "Monitor"), deny: /child publication\/integration command: git push/ },
		{ id: "subagent-powershell-push", stdin: event("git push origin agent/x", worker, "PowerShell"), deny: /child publication\/integration command: git push/ },
		{ id: "subagent-mention", stdin: event("rg \"error|git push\" docs/", worker), deny: /child publication\/integration command: git push.*only mentions the command.*git commit -F <file>/ },
		{ id: "subagent-gh-merge", stdin: event("gh pr merge 3 --squash", worker), deny: /child publication\/integration command: gh pr merge.*without gh in front/ },
		{ id: "subagent-gh-view", stdin: event("gh pr view 3", worker) },
		{ id: "subagent-absolute-push", stdin: event("/usr/bin/git push origin agent/x", worker), deny: /child publication\/integration command: git push/ },
		{ id: "subagent-merge-base", stdin: event("git merge-base HEAD origin/main", worker) },
		{ id: "subagent-tag-list", stdin: event("git tag -l", worker) },
		{ id: "subagent-tag-redirect", stdin: event("git tag 2>/dev/null", worker) },
		{ id: "subagent-local", stdin: event("git commit -m local", worker) },
		{ id: "subagent-not-git", stdin: event("ls -la", worker) },
		{ id: "subagent-write", stdin: preToolUseEvent(run.runId, project, { file_path: join(project, "x.sh"), content: "git push --no-verify" }, worker, "Write") },
		{ id: "owner-push", stdin: event("git push --force-with-lease=agent/x:abc origin agent/x", owner) },
		{ id: "owner-no-verify", stdin: event("git commit --no-verify -m x", owner), deny: skip },
		{ id: "owner-commit-n", stdin: event("git commit -nm x", owner), deny: /skipping git hooks with -n/ },
		{ id: "owner-gh-merge", stdin: event("gh pr merge 3 --squash", owner) },
		{ id: "malformed", stdin: "not json", deny: /could not read the PreToolUse event/ },
	];
	const exposed = rec.step("hook-project-bunfig-without-cwd", ["bun", hookCli, "--claude-hook"], { cwd: project, input: event("git commit --no-verify -m x") });
	rec.check(exposed.stdout.startsWith("project preload ran"), "project-bunfig: without --cwd, the project's preload prints before the decision, so the fixture bites");
	const before = sh(["git", "rev-parse", "--verify", "-q", "HEAD"], { cwd: project }).stdout.trim();
	const configBefore = readFileSync(join(project, ".git", "config"), "utf8");
	for (const c of cases) {
		const result = rec.step(`hook-${c.id}`, [...hook, "--claude-hook"], { cwd: project, input: c.stdin });
		rec.check(result.status === 0, `${c.id}: the hook exits 0 (got ${result.status})`);
		if (c.deny === undefined) {
			rec.check(result.stdout.trim() === "", `${c.id}: the hook allows by printing nothing (got "${result.stdout.trim()}")`);
			continue;
		}
		const decision = parseJson(result.stdout) as { hookSpecificOutput?: Record<string, unknown> } | undefined;
		const output = decision?.hookSpecificOutput;
		rec.check(decision !== undefined && Object.keys(decision).length === 1 && output?.hookEventName === "PreToolUse" && output.permissionDecision === "deny", `${c.id}: the hook prints exactly Claude Code's PreToolUse deny decision (got "${result.stdout.trim()}")`);
		rec.check(typeof output?.permissionDecisionReason === "string" && c.deny.test(output.permissionDecisionReason), `${c.id}: the deny reason matches ${c.deny} (got ${JSON.stringify(output?.permissionDecisionReason)})`);
	}
	const usage = rec.step("hook-usage", hook, { cwd: project });
	rec.check(usage.status === 2 && usage.stdout.trim() === "", `the hook without --claude-hook is a usage error, exit 2 with no decision (got ${usage.status})`);
	// The hook reads text and runs nothing: the scratch repository has no commit afterwards, as before.
	rec.check(before === "" && sh(["git", "rev-parse", "--verify", "-q", "HEAD"], { cwd: project }).stdout.trim() === "", "the hook ran none of the commands: the scratch project still has no commit");
	rec.check(readFileSync(join(project, ".git", "config"), "utf8") === configBefore, "the hook ran none of the git config commands: the scratch project's .git/config is unchanged");
}

function drive(runId: string | undefined, feature: string | undefined, options: Options): Outcome {
	const run = loadRun(runId);
	if (!FEATURES.includes(feature as Feature)) throw new Usage(`unknown feature "${feature ?? ""}"; choose one of ${FEATURES.join(", ")}`);
	const rec = new Recorder(join(evidenceDir(run.runId), feature!), run.checkout);
	try {
		const moved = bound(run);
		if (moved) rec.check(false, moved);
		else {
			switch (feature as Feature) {
				case "task-route": driveTaskRoute(run, rec); break;
				case "verdict-gate": driveVerdictGate(run, rec, options); break;
				case "pr-state": drivePrState(run, rec, options); break;
				case "skill-catalog": driveSkillCatalog(run, rec); break;
				case "claude-surface": driveClaudeSurface(run, rec); break;
				case "git-guard": driveGitGuard(run, rec); break;
			}
			const after = bound(run);
			if (after) rec.check(false, after);
		}
	} catch (error) {
		rec.check(false, `drive stopped: ${(error as Error).message}`);
	}
	const outcome = rec.outcome();
	const line = outcome.state === "PASS" ? `PASS ${feature}` : `${outcome.state} ${feature}: ${outcome.detail}`;
	// Record what this process observes now, beside what launch recorded, so a reader can compare them.
	const observed = (path: string) => { try { return `${git(["rev-parse", "HEAD"], path)} tree ${treeDigest(path)}`; } catch (error) { return `unreadable (${(error as Error).message})`; } };
	const failed = rec.failures.map((failure) => `failed: ${failure}\n`).join("");
	rec.note("result.txt", `${line}\n${failed}${run.dirty ? `${DIRTY}\n` : ""}checkout ${run.checkout}: launched at ${run.revision} tree ${run.tree}, driven at ${observed(run.checkout)}\nkit ${run.kit}: launched at ${run.kitRevision} tree ${run.kitTree}, driven at ${observed(run.kit)}\n`);
	if (run.dirty) console.log(DIRTY);
	console.log(line);
	return outcome;
}

function driveOptions(args: string[]): Options {
	const slug = option(args, "--repo");
	if (slug !== undefined && !/^[\w.-]+\/[\w.-]+$/.test(slug)) throw new Usage(`--repo must be owner/name, got "${slug}"`);
	return { slug, pr: positiveInt(option(args, "--pr"), "--pr"), mergedPr: positiveInt(option(args, "--merged-pr"), "--merged-pr") };
}

function all(args: string[]): number {
	const options = driveOptions(args);
	const checkout = option(args, "--checkout");
	const runId = launch([...(checkout ? ["--checkout", checkout] : []), ...["--install", "--allow-dirty"].filter((flag) => args.includes(flag))]);
	const { dirty } = loadRun(runId);
	const counts = { PASS: 0, FAIL: 0, SKIP: 0 };
	let doctorOk = false;
	try {
		doctorOk = doctor(runId);
		if (doctorOk) for (const feature of FEATURES) counts[drive(runId, feature, options).state]++;
	} finally {
		cleanup(runId);
	}
	const summary = `ALL ${runId}: ${counts.PASS} pass, ${counts.FAIL} fail, ${counts.SKIP} skip${doctorOk ? "" : " (doctor failed; nothing driven)"}${dirty ? " (dirty run: cannot back a verdict)" : ""}`;
	writeFileSync(join(evidenceDir(runId), "all.txt"), summary + "\n");
	console.log(summary);
	return doctorOk && counts.FAIL === 0 ? 0 : 1;
}

function main(args: string[]): number {
	const [command, ...rest] = args;
	if (command === undefined) return console.log(HELP.main), 2;
	if (command === "help" || command === "--help" || command === "-h") return console.log(HELP.main), 0;
	if (!(command in HELP) || command === "main") throw new Usage(`unknown command "${command}"; run "${CLI} --help"`);
	if (rest.includes("--help") || rest.includes("-h")) return console.log(HELP[command]), 0;
	switch (command) {
		case "launch": return launch(rest), 0;
		case "doctor": return doctor(rest[0]) ? 0 : 1;
		case "drive": return drive(rest[0], rest[1], driveOptions(rest.slice(2))).state === "FAIL" ? 1 : 0;
		case "cleanup": return cleanup(rest[0]), 0;
		case "all": return all(rest);
	}
	throw new Usage(`unknown command "${command}"`);
}

try {
	process.exit(main(process.argv.slice(2)));
} catch (error) {
	console.error(`verify-kit: ${(error as Error).message}`);
	process.exit(error instanceof Usage ? 2 : 1);
}
