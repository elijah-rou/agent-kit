#!/bin/sh
# Claude Code PreToolUse hook. Claude lets a tool run when its hook cannot start, so a missing bun
# or a missing CLI becomes an explicit deny here instead of a failed command.
deny() {
	printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"[agentic] %s; failing closed"}}\n' "$1"
	exit 0
}
entry="$(dirname "$0")/agentic"
[ -f "$entry" ] || deny "the agentic CLI is missing"
bun="$(command -v bun 2>/dev/null)"
# Bootstrap links agent-kit at tools/agent-kit and bun at tools/bin/bun, for sessions started
# without bootstrap's PATH.
for candidate in "$(dirname "$0")/../../../bin/bun" "${BUN_INSTALL:+$BUN_INSTALL/bin/bun}" "$HOME/.bun/bin/bun"; do
	[ -n "$bun" ] && break
	if [ -n "$candidate" ] && [ -x "$candidate" ]; then bun="$candidate"; fi
done
[ -n "$bun" ] || deny "bun was not found"
exec "$bun" "$entry" claude-hook
